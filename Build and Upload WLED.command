#!/usr/bin/env bash
set -Eeuo pipefail

# AI: below section was generated by an AI
# macOS double-click launcher for the complete WLED update/build/upload workflow.

launcher_directory="$(
  CDPATH='' cd -- "$(dirname -- "$0")" >/dev/null 2>&1
  pwd -P
)"
workflow="$launcher_directory/scripts/update-build-deploy-wled.sh"
deployment_config="$launcher_directory/.env.wled-deploy"

finish() {
  local exit_code=$?
  trap - EXIT

  printf '\n'
  if ((exit_code == 0)); then
    printf 'Build and upload finished successfully.\n'
  else
    printf 'Build and upload stopped with an error (exit %d).\n' "$exit_code" >&2
  fi

  if [[ -t 0 ]]; then
    printf 'Press Return to close this window...'
    IFS= read -r _ || true
  fi

  exit "$exit_code"
}
trap finish EXIT

[[ -x "$workflow" ]] || {
  printf 'Error: workflow script is missing or not executable:\n  %s\n' "$workflow" >&2
  exit 2
}

if [[ ! -f "$deployment_config" && "${LOOMX_WLED_LAUNCHER_TEST:-0}" != "1" ]]; then
  printf 'Server deployment is not configured yet.\n\n' >&2
  printf 'Create this private file before running again:\n  %s\n\n' "$deployment_config" >&2
  printf 'Start by copying:\n  %s\n' "$launcher_directory/.env.wled-deploy.example" >&2
  exit 3
fi

cd "$launcher_directory"
printf 'Loomx WLED — update, build, and upload\n'
printf 'Repository: %s\n\n' "$launcher_directory"

# This environment-only branch lets maintainers validate the launcher without
# merging, building, pushing, or uploading. Normal double-click use passes no
# flags and always runs the complete workflow.
if [[ "${LOOMX_WLED_LAUNCHER_TEST:-0}" == "1" ]]; then
  "$workflow" --dry-run
else
  "$workflow"
fi
# AI: end
